PATH_RE = re.compile(r"^[A-Za-z0-9._/-]+$")
SLIDE_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
FLAG_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SHA_RE = re.compile(r"^[0-9a-f]{64}$")
# A bundle path inside text is only a reference when it is not glued to a
# longer path or word (contract: "not preceded by [A-Za-z0-9_./-]").
REF_BOUNDARY = r"(?<![A-Za-z0-9_./-])"

