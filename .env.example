# SQLite for a single-instance install; use Postgres for multi-instance hosting.
DATABASE_URL=sqlite:///./showcase.db
CORS_ORIGINS=["http://127.0.0.1:8000"]
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=73400320
# Production requires a configured JWT identity provider (no anonymous writes).
FORWARDED_AUTH_MODE=forwarded
FORWARDED_AUTH_ISSUER=
FORWARDED_AUTH_AUDIENCE=
FORWARDED_AUTH_ALLOWED_EMAIL_DOMAINS=
# For offline loopback-only demos ONLY:
# FORWARDED_AUTH_MODE=none
# FORWARDED_AUTH_ALLOW_INSECURE_NONE_MODE=1
